<Window x:Class="PizzaSplit.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PizzaSplit" 
        Height="576" 
        Width="802" 
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Top">
            <TextBlock Text="Tellimuse summa (€):" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtTotal" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

            <TextBlock Text="Sööjate arv (1–20):" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtPeople" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

            <CheckBox x:Name="ChkTip" Content="10% jootraha" Margin="0,0,0,15" IsChecked="False"/>

            <Button x:Name="BtnCalculate" Content="Arvuta" Height="32" Click="BtnCalculate_Click" Margin="0,0,0,15"/>

            <TextBlock Text="Igaüks maksab (€):" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtShare" Height="28" VerticalContentAlignment="Center" IsReadOnly="True" Background="#F0F0F0" Margin="0,0,0,10"/>

            <TextBlock x:Name="TxtError" FontSize="13" Foreground="Red" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>